  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ShotSpace Lens Controls</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 lensController {"hint":"Authored LensController component that owns ShotCamera focal-length presets."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Panel Placement"}'
    - '// @input float panelWidthCm = 29 {"hint":"Width shared by the status and control backplates, in centimeters.", "widget":"slider", "min":26, "max":36, "step":0.2}'
    - '// @input float statusPanelHeightCm = 14.2 {"hint":"Height of the status/header backplate above PreviewScreen, in centimeters.", "widget":"slider", "min":10, "max":18, "step":0.2}'
    - '// @input float controlPanelHeightCm = 12.6 {"hint":"Height of the combined focal, framing, and Match control backplate, in centimeters.", "widget":"slider", "min":10, "max":18, "step":0.2}'
    - '// @input float statusCenterXCm = 5 {"hint":"Local X center of the status group so it remains aligned above PreviewScreen.", "widget":"slider", "min":-15, "max":15, "step":0.5}'
    - '// @input float statusCenterYCm = 12 {"hint":"Local Y center of the status/header group above the 16x9 PreviewScreen.", "widget":"slider", "min":8, "max":16, "step":0.2}'
    - '// @input float controlsCenterXCm {"hint":"Local X center of the compact button panel.", "widget":"slider", "min":-15, "max":15, "step":0.5}'
    - '// @input float controlsCenterYCm = -18 {"hint":"Local Y center of the combined controls below PreviewPanel.", "widget":"slider", "min":-24, "max":-12, "step":0.2}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Control Spacing"}'
    - '// @input float buttonWidthCm = 6 {"hint":"Width of each native UIKit focal-length button, in centimeters.", "widget":"slider", "min":5.5, "max":7, "step":0.1}'
    - '// @input float buttonHeightCm = 3 {"hint":"Height of each native UIKit focal-length button, in centimeters.", "widget":"slider", "min":2.4, "max":4, "step":0.1}'
    - '// @input float buttonGapCm = 0.8 {"hint":"Horizontal gap between neighboring focal-length buttons, in centimeters.", "widget":"slider", "min":0.4, "max":1.5, "step":0.1}'
    - '// @input float framingButtonWidthCm = 8.2 {"hint":"Width of each framing button; sized so CLOSE-UP remains readable.", "widget":"slider", "min":7, "max":9, "step":0.1}'
    - '// @input float controlRowGapCm = 0.5 {"hint":"Vertical gap between focal, framing, and Match rows.", "widget":"slider", "min":0.2, "max":1, "step":0.1}'
    - '// @input float matchSwitchWidthCm = 7 {"hint":"Width of the native UIKit Match Framing switch.", "widget":"slider", "min":5, "max":9, "step":0.1}'
    - '// @input float panelPaddingCm = 1 {"hint":"Inset between panel edges and their content, in centimeters.", "widget":"slider", "min":0.5, "max":2, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Typography and Color"}'
    - '// @input float fontSizeScale = 1 {"hint":"Global multiplier for the Specs type-scale roles used by this panel.", "widget":"slider", "min":0.8, "max":1.2, "step":0.01}'
    - '// @input vec4 primaryTextColor = "{1,1,1,1}" {"hint":"Primary color for current-lens text and unselected button labels.", "widget":"color"}'
    - '// @input vec4 secondaryTextColor = "{1,1,1,0.7}" {"hint":"Secondary color for the educational focal-length description.", "widget":"color"}'
    - '// @input vec4 accentColor = "{0.35,0.8,1,1}" {"hint":"Accent color applied to the selected focal-length button label.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
