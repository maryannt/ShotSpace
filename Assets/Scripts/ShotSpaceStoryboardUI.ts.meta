    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ShotSpace Storyboard Rail</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float railWidthCm = 15.2 {"hint":"Width of the storyboard rail backplate, in centimeters.", "widget":"slider", "min":12, "max":20, "step":0.1}'
