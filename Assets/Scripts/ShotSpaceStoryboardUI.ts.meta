    - '// @input float actionButtonHeightCm = 1.4 {"hint":"Height of the save and clear buttons.", "widget":"slider", "min":1.3, "max":2.4, "step":0.1}'
    - '// @input float panelPaddingCm = 0.3 {"hint":"Inset between the rail edge and its content.", "widget":"slider", "min":0.15, "max":0.8, "step":0.05}'
    - '// @input float fontSizeScale = 0.78 {"hint":"Global multiplier for the Specs type-scale roles used by this rail.", "widget":"slider", "min":0.65, "max":1.1, "step":0.01}'
    - '// @input vec4 primaryTextColor = "{1,1,1,1}" {"hint":"Primary text color for occupied card metadata and button labels.", "widget":"color"}'
    - '// @input vec4 secondaryTextColor = "{1,1,1,0.55}" {"hint":"Secondary text color for empty cards and status.", "widget":"color"}'
