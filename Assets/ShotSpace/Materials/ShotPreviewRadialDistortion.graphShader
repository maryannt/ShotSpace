      TemplateID: nodes_inputs_parameters_float
      Title1: Float Parameter
      Title2: Distortion Blend
    Node4:
      DependencyIndex: 4
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_texture_2d baseTexture;
            input_float distortionK1;
            input_float distortionK2;
            input_float blendAmount;
            output_vec4 result;
            
            void main()
            {
            	const float aspect = 1.7777778;
            	vec2 uv = system.getSurfaceUVCoord0();
            	vec2 centeredUV = uv * 2.0 - 1.0;
            	centeredUV.x *= aspect;
            
            	float r2 = dot(centeredUV, centeredUV);
            	float r4 = r2 * r2;
            	float radialScale = 1.0 + distortionK1 * r2 + distortionK2 * r4;
            	vec2 distortedCenteredUV = centeredUV * radialScale;
            	distortedCenteredUV.x /= aspect;
            	vec2 distortedUV = distortedCenteredUV * 0.5 + 0.5;
            	vec2 finalUV = mix(uv, distortedUV, clamp(blendAmount, 0.0, 1.0));
            
            	float valid =
            		step(0.0, finalUV.x) * step(finalUV.x, 1.0) *
            		step(0.0, finalUV.y) * step(finalUV.y, 1.0);
            	vec4 sampledColor = baseTexture.sample(clamp(finalUV, vec2(0.0), vec2(1.0)));
            	result = vec4(sampledColor.rgb * valid, 1.0);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: Static 16:9 radial UV distortion with clean black invalid-UV masking.
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Radial Lens Distortion
        UseExternalFile:
          Variable: false
        baseTexture:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 2
            PortID: Texture
        distortionK1:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: 0.0
        distortionK2:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.0
        blendAmount:
          Connection0:
            NodeLevelID: 4
            PortID: Output
          Variable: 1.0
        ngs_Height:
          Variable: 650
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -210
      PositionY: 40
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Radial Lens Distortion
